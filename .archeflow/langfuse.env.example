# ArcheFlow -> Langfuse export (optional). Off unless LANGFUSE_ENABLED=true.
#
# Put a copy of this file in ONE of these places (the first one found is used):
#   ${XDG_CONFIG_HOME:-~/.config}/archeflow/langfuse.env
#   ~/.archeflow/langfuse.env
# A langfuse.env inside a project (.archeflow/langfuse.env) is never read, committed or not:
# a cloned repository could otherwise send your run data (task text, findings, file names) to a
# host it chose. Earlier versions read an untracked project file; move it to the path above.
#
# Alternative: set LANGFUSE_ENABLED=true and the three values below in the environment.
# Settings are never mixed: either all come from the environment or all from one file.
#
# The host must be https://, or http:// on a loopback address (localhost, 127.x, [::1]).
# The file is parsed as KEY=VALUE data, never executed. See lib/archeflow-langfuse.sh.

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_ENABLED=true
